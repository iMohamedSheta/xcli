<script setup lang="ts">
import { ref, watch, computed, onMounted } from "vue";
import { router } from "@inertiajs/vue3";
import { Head } from '@inertiajs/vue3';
import { Check, MoreVertical, Search as SearchIcon, EyeOff, EyeIcon, ArrowUp, ArrowDown, Search, ChevronDownIcon, XCircle, CheckCircle2, Trash2, Copy, Edit } from "lucide-vue-next";
import AppLayout from '@/layouts/AppLayout.vue';
import {
  Pagination,
  PaginationContent,
  PaginationEllipsis,
  PaginationItem,
  PaginationNext,
  PaginationPrevious,
} from '@/components/ui/pagination'
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table"
import Button from "@/components/ui/button/Button.vue";
import Input from "@/components/ui/input/Input.vue";
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuLabel,
  DropdownMenuTrigger,
  DropdownMenuSeparator,
  DropdownMenuItem,
} from "@/components/ui/dropdown-menu"
import {
  Popover,
  PopoverContent,
  PopoverTrigger,
} from "@/components/ui/popover"
import Select from "@/components/ui/select/Select.vue";
import SelectTrigger from "@/components/ui/select/SelectTrigger.vue";
import SelectValue from "@/components/ui/select/SelectValue.vue";
import SelectContent from "@/components/ui/select/SelectContent.vue";
import SelectGroup from "@/components/ui/select/SelectGroup.vue";
import SelectItem from "@/components/ui/select/SelectItem.vue";
import Badge from "@/components/ui/badge/Badge.vue";
import Add{{ENTITY}} from "@/components/app/{{ENTITY}}/Add{{ENTITY}}.vue";
import ConfirmDeleteModal from "@/components/app/ConfirmDeleteModal.vue";
import { formatDate } from "@/lib/format";
import type { BreadcrumbItem, PaginationMeta, {{ENTITY}} } from '@/types';
import { useSweetAlert } from "@/composables/useSweetAlert";
import ConfirmationDialog from "@/components/app/ConfirmationDialog.vue";

// ==================== CONSTANTS & PROPS ====================

const breadcrumbs: BreadcrumbItem[] = [
  { title: '{{entity_ar_plural}}', href: '/{{route_name}}' },
];

const pageProps = withDefaults(
  defineProps<{
    {{entities}}: {{ENTITY}}[]
    paginate_meta: PaginationMeta,
  }>(),
  {
    {{entities}}: () => [],
  }
)

// ==================== REACTIVE STATE ====================

// Modal States
const isModalOpen = ref(false)
const {{entity}}ToEdit = ref<Partial<{{ENTITY}}> | null>(null)
const {{entity}}ToDuplicate = ref<Partial<{{ENTITY}}> | null>(null)

// Delete Modal State
const showDeleteDialog = ref(false);
const {{entity}}ToDelete = ref<number | null>(null);

// Selection State
const selectedIds = ref<number[]>([])

// Filters & Sorting
const searchQuery = ref("")
const columnSearch = ref<Record<string, string>>({})
const sortBy = ref<{ column: string; direction: "asc" | "desc" | null }>({
  column: "",
  direction: null
})

// UI State
const isMobile = ref(window.innerWidth < 768)
const searchTimeout = ref<ReturnType<typeof setTimeout> | null>(null)

// Column Configuration
const columns = ref([
  { key: "name", label: "الاسم", visible: true, visible_mobile: true, options: true },
  { key: "created_at", label: "تاريخ الإنشاء", visible: true, visible_mobile: false, options: true },
])

// ==================== COMPUTED PROPERTIES ====================

const isAllSelected = computed(() => {
  return pageProps.{{entities}}.length > 0 && pageProps.{{entities}}.every(o => selectedIds.value.includes(o.id))
})

const isIndeterminate = computed(() => {
  const selectedCount = pageProps.{{entities}}.filter(o => selectedIds.value.includes(o.id))?.length
  return selectedCount > 0 && selectedCount < pageProps.{{entities}}.length
})

// ==================== WATCHERS ====================

// Search query watcher with debounce
watch(searchQuery, () => {
  if (searchTimeout.value) clearTimeout(searchTimeout.value)
  searchTimeout.value = setTimeout(() => sendRequest(), 500)
})

// Sort watcher
watch([sortBy], () => sendRequest(), { deep: true })

// Column search watcher with debounce
watch([columnSearch], () => {
  if (searchTimeout.value) clearTimeout(searchTimeout.value)
  searchTimeout.value = setTimeout(() => sendRequest(), 500)
}, { deep: true })

// ==================== EVENT HANDLERS ====================

// Window resize handler
window.addEventListener('resize', () => {
  isMobile.value = window.innerWidth < 768
})

// ==================== SELECTION METHODS ====================

/**
 * Toggle selection of all {{entities}} on current page
 */
function toggleSelectAll() {
  if (isAllSelected.value) {
    selectedIds.value = selectedIds.value?.filter(id => !pageProps.{{entities}}.some(o => o.id === id))
  } else {
    const currentPageIds = pageProps.{{entities}}.map(o => o.id)
    const newSelection = [...selectedIds.value]
    currentPageIds.forEach(id => {
      if (!newSelection.includes(id)) newSelection.push(id)
    })
    selectedIds.value = newSelection
  }
}

/**
 * Toggle selection of individual {{entity}} row
 */
function toggleSelectRow({{entity}}Id: number) {
  if (selectedIds.value.includes({{entity}}Id)) {
    selectedIds.value = selectedIds.value?.filter(id => id !== {{entity}}Id)
  } else {
    selectedIds.value = [...selectedIds.value, {{entity}}Id]
  }
}

// ==================== DELETE METHODS ====================

/**
 * Open delete confirmation dialog
 */
function openDeleteDialog({{entity}}Id: number) {
  {{entity}}ToDelete.value = {{entity}}Id;
  showDeleteDialog.value = true;
}

/**
 * Close delete confirmation dialog
 */
function closeDeleteDialog() {
  showDeleteDialog.value = false;
  setTimeout(() => {
    {{entity}}ToDelete.value = null;
  }, 150);
}

/**
 * Handle {{entity}} deletion confirmation
 */
function handleDeleteConfirm(password?: string) {
  if (!{{entity}}ToDelete.value) return;

  router.delete('/{{route_name}}/' + {{entity}}ToDelete.value, {
    preserveScroll: true,
    preserveState: true,
    onSuccess: closeDeleteDialog
  });
}

// ==================== FILTERS & SORTING METHODS ====================

/**
 * Build query parameters for API request
 */
function buildQuery() {
  const q: Record<string, any> = {}

  if (searchQuery.value) q.search = searchQuery.value
  if (sortBy.value.column) {
    q.sort_order = `${sortBy.value.direction}`
    q.sort_by = `${sortBy.value.column}`
  }
  for (const col in columnSearch.value) {
    if (columnSearch.value[col]) {
      q[`search_by[${col}]`] = columnSearch.value[col]
    }
  }

  q.page = 1
  q.per_page = pageProps.paginate_meta.per_page

  return q
}

/**
 * Send filtered/sorted request to server
 */
function sendRequest() {
  router.get("/{{route_name}}", buildQuery(), {
    preserveScroll: true,
    preserveState: true,
    replace: true,
  })
}

/**
 * Clear all filters and refresh data
 */
function clearFiltersAndSendRequest() {
  searchQuery.value = ''
  columnSearch.value = {}
  sortBy.value = { column: "", direction: null }
  sendRequest()
}

/**
 * Navigate to specific pagination page
 */
function goToPaginationPage(page: number, per_page: number) {
  router.get(
    "/{{route_name}}",
    {
      page: page,
      per_page: per_page,
    },
    {
      preserveScroll: true,
      preserveState: true,
      replace: true,
    }
  )
}

// ==================== MODAL METHODS ====================

/**
 * Handle modal close event
 */
function handleModalClose(isOpen: boolean) {
  isModalOpen.value = isOpen
  if (!isOpen) {
    {{entity}}ToDuplicate.value = null
    {{entity}}ToEdit.value = null
  }
}

// ==================== DUPLICATE METHODS ====================

/**
 * Prepare {{entity}} for editing
 */
const update{{ENTITY}} = ({{entity}}: {{ENTITY}}) => {
  const parsed{{ENTITY}} = {
    ...{{entity}},
  }

  // Clear duplicate {{entity}} and set edit {{entity}}
  {{entity}}ToDuplicate.value = null
  {{entity}}ToEdit.value = parsed{{ENTITY}}
  isModalOpen.value = true
}

/**
 * Prepare {{entity}} for duplication
 */
const duplicate{{ENTITY}} = ({{entity}}: {{ENTITY}}) => {
  const parsed{{ENTITY}} = {
    ...{{entity}},
  }

  // Clear edit {{entity}} and set duplicate {{entity}}
  {{entity}}ToEdit.value = null
  {{entity}}ToDuplicate.value = parsed{{ENTITY}}
  isModalOpen.value = true
}
</script>

<template>

  <Head title="{{entity_ar_plural}}" />
  <AppLayout :breadcrumbs="breadcrumbs">
    <div class="flex h-full flex-1 flex-col gap-6 rounded-xl p-6 overflow-x-auto">
      <div
        class="relative min-h-[100vh] flex-1 rounded-xl border border-sidebar-border/70 md:min-h-min dark:border-sidebar-border p-6">

        <div>
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-3">
              <Add{{ENTITY}} :is-open="isModalOpen" @update:is-open="handleModalClose" :duplicate-{{entity}}="{{entity}}ToDuplicate"
                :{{entity}}-to-edit="{{entity}}ToEdit" />
            </div>
          </div>

          <!-- Filters and actions -->
          <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-6">
            <div class="w-full flex gap-2 md:w-1/3">
              <!-- Column Visibility -->
              <DropdownMenu>
                <DropdownMenuTrigger as-child>
                  <Button variant="outline">
                    <EyeOff class="w-5 h-5 mr-2" /> أعمدة
                  </Button>
                </DropdownMenuTrigger>
                <DropdownMenuContent align="center" class="w-90 md:w-auto">
                  <DropdownMenuLabel>إظهار/إخفاء الأعمدة</DropdownMenuLabel>
                  <DropdownMenuSeparator />
                  <DropdownMenuItem v-for="col in columns" :key="col.key" @click="col.visible = !col.visible">
                    <Check v-if="col.visible" class="w-4 h-4 mr-2" />
                    {{ col.label }}
                  </DropdownMenuItem>
                  <DropdownMenuSeparator />
                  <DropdownMenuItem @click="columns.forEach(col => col.visible = true)">
                    <EyeIcon />
                    اظهار الكل
                  </DropdownMenuItem>
                </DropdownMenuContent>
              </DropdownMenu>
              <Input v-model="searchQuery" type="text" placeholder="ابحث عن {{entity_ar_plural}}..." class="w-full" />
            </div>
            <div class="gap-4 flex">
              <div v-if="selectedIds?.length > 0" class="items-center gap-4 hidden lg:flex">
                <span class="text-sm text-muted-foreground">
                  {{ selectedIds?.length === 1 ? 'عنصر واحد' : selectedIds?.length + ' عناصر' }} محدد
                </span>
              </div>
            </div>
          </div>

          <!-- Table / Grid -->
          <div class="w-full">
            <div class="rounded-md border">
              <!-- Desktop Table -->
              <div v-if="!isMobile" class="hidden md:block">
                <Table class="bg-sidebar">
                  <TableHeader>
                    <TableRow>
                      <!-- Select All -->
                      <TableHead class="text-center w-12">
                        <label class="inline-flex items-center cursor-pointer select-none">
                          <input type="checkbox" :checked="isAllSelected" @change="toggleSelectAll"
                            class="sr-only peer" />
                          <span class="w-5 h-5 rounded-md border border-gray-300 dark:border-gray-600 
           peer-checked:bg-primary peer-checked:border-primary 
           peer-checked:text-primary-foreground
           peer-indeterminate:bg-primary peer-indeterminate:border-primary
           flex items-center justify-center 
           transition-colors duration-200
           focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                            <svg v-if="isAllSelected" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none"
                              viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3"
                                d="M5 13l4 4L19 7" />
                            </svg>
                            <div v-else-if="isIndeterminate" class="w-3 h-0.5 bg-white rounded"></div>
                          </span>
                        </label>
                      </TableHead>
                      <TableHead class="text-center">#</TableHead>
                      <TableHead v-for="col in columns?.filter(c => c.visible)" :key="col.key" class="text-center">
                        <Popover v-if="col.options">
                          <PopoverTrigger as-child>
                            <Button variant="ghost" size="sm"
                              class="w-full justify-between px-2 font-medium hover:bg-muted/50">
                              <span>{{ col.label }}</span>
                              <MoreVertical class="w-4 h-4 opacity-70" />
                            </Button>
                          </PopoverTrigger>
                          <PopoverContent class="w-44 rounded-lg border shadow-md bg-popover p-2" align="start">
                            <div class="flex flex-col gap-1">
                              <Button variant="ghost" size="sm" class="justify-start text-sm hover:bg-muted/40"
                                @click="sortBy = { column: col.key, direction: 'asc' }">
                                <ArrowUp class="w-4 h-4 mr-2 text-muted-foreground" />
                                <span>ترتيب تصاعدي</span>
                              </Button>
                              <Button variant="ghost" size="sm" class="justify-start text-sm hover:bg-muted/40"
                                @click="sortBy = { column: col.key, direction: 'desc' }">
                                <ArrowDown class="w-4 h-4 mr-2 text-muted-foreground" />
                                <span>ترتيب تنازلي</span>
                              </Button>
                              <div class="h-px my-1 bg-border" />
                              <div class="p-1">
                                <Input v-model="columnSearch[col.key]" type="text" placeholder="ابحث"
                                  class="w-full text-xs text-right" />
                              </div>
                            </div>
                          </PopoverContent>
                        </Popover>
                        <span v-else>{{ col.label }}</span>
                      </TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    <TableRow v-for="({{entity}}, index) in {{entities}}" :key="{{entity}}.id"
                      :class="{ 'bg-muted/50': selectedIds.includes({{entity}}.id) }">
                      <TableCell class="text-center">
                        <label class="inline-flex items-center cursor-pointer select-none">
                          <input type="checkbox" :checked="selectedIds.includes({{entity}}.id)"
                            @change="toggleSelectRow({{entity}}.id)" class="sr-only peer" />
                          <span class="w-4 h-4 rounded-md border border-gray-300 dark:border-gray-600 
                            peer-checked:bg-primary peer-checked:border-primary 
                            peer-checked:text-primary-foreground
                            flex items-center justify-center 
                            transition-colors duration-200">
                            <svg v-if="selectedIds.includes({{entity}}.id)" xmlns="http://www.w3.org/2000/svg"
                              class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3"
                                d="M5 13l4 4L19 7" />
                            </svg>
                          </span>
                        </label>
                      </TableCell>
                      <TableCell class="text-center">
                        {{ (paginate_meta.per_page * (paginate_meta.current_page - 1)) + (index + 1) }}
                      </TableCell>
                      <TableCell v-if="columns.find(c => c.key === 'name')?.visible" class="text-center">
                        <div class="font-semibold">
                          <DropdownMenu>
                            <DropdownMenuTrigger as-child>
                              <Button variant="outline" size="sm">
                                {{entity_name_placeholder}}
                                <ChevronDownIcon class="w-4 h-4" />
                              </Button>
                            </DropdownMenuTrigger>
                            <DropdownMenuContent align="center" class="w-90 md:w-auto">
                              <DropdownMenuItem @click="update{{ENTITY}}({{entity}})">
                                <Edit class="w-4 h-4 mr-2" />
                                تعديل
                              </DropdownMenuItem>
                              <DropdownMenuItem @click="duplicate{{ENTITY}}({{entity}})">
                                <Copy class="w-4 h-4 mr-2" />
                                نسخ
                              </DropdownMenuItem>
                              <DropdownMenuSeparator />
                              <DropdownMenuItem @click="openDeleteDialog({{entity}}.id)">
                                <Trash2 class="w-4 h-4 mr-2" />
                                حذف
                              </DropdownMenuItem>
                            </DropdownMenuContent>
                          </DropdownMenu>
                        </div>
                      </TableCell>
                      <TableCell v-if="columns.find(c => c.key === 'created_at')?.visible" class="text-center">
                        {{entity_created_at_placeholder}}
                      </TableCell>
                    </TableRow>
                  </TableBody>
                </Table>
              </div>

              <!-- Mobile Grid -->
              <div v-else class="md:hidden space-y-4 p-2">
                <div v-for="({{entity}}, index) in {{entities}}" :key="{{entity}}.id"
                  class="p-4 border rounded-lg shadow-sm text-sm space-y-2"
                  :class="{ 'bg-muted/50 border-primary': selectedIds.includes({{entity}}.id) }">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <label class="inline-flex items-center cursor-pointer select-none">
                        <input type="checkbox" :checked="selectedIds.includes({{entity}}.id)"
                          @change="toggleSelectRow({{entity}}.id)" class="sr-only peer" />
                        <span class="w-4 h-4 rounded-md border border-gray-300 dark:border-gray-600 
           peer-checked:bg-primary peer-checked:border-primary 
           peer-checked:text-primary-foreground
           flex items-center justify-center 
           transition-colors duration-200">
                          <svg v-if="selectedIds.includes({{entity}}.id)" xmlns="http://www.w3.org/2000/svg" class="w-3 h-3"
                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                          </svg>
                        </span>
                      </label>
                      <div class="flex items-center">
                        <span class="text-lg font-medium">#</span>
                        <span class="text-2xl px-1 font-semibold">
                          {{ (paginate_meta.per_page * (paginate_meta.current_page - 1)) + (index + 1) }}
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="mt-2 space-y-2">
                    <div v-for="col in columns?.filter(c => c.visible_mobile)" :key="col.key"
                      class="flex justify-between text-sm">
                      <span class="font-medium">{{ col.label }}:</span>
                      <span>
                        <template v-if="col.key === 'name'">{{entity_name_placeholder}}</template>
                        <template v-else-if="col.key === 'created_at'">{{entity_created_at_placeholder}}</template>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Empty State -->
        <div v-if="{{entities}}.length === 0" class="text-center py-12">
          <Search class="w-12 h-12 mx-auto mb-2 text-muted-foreground" />
          <h3 class="text-lg font-semibold mb-2">لا توجد نتائج</h3>
          <Button @click="clearFiltersAndSendRequest()">مسح الفلاتر</Button>
        </div>

        <!-- Pagination -->
        <Pagination v-if="pageProps.paginate_meta.total_count > 0 && pageProps.paginate_meta.last_page != 1"
          class="flex justify-between items-end p-8" :page="pageProps.paginate_meta.current_page"
          :items-per-page="pageProps.paginate_meta.per_page" :total="pageProps.paginate_meta.total_count">
          <Select>
            <SelectTrigger size="sm">
              <SelectValue :placeholder="pageProps.paginate_meta.per_page.toString()" />
            </SelectTrigger>
            <SelectContent>
              <SelectGroup>
                <SelectItem @click="goToPaginationPage(pageProps.paginate_meta.current_page, value)"
                  v-for="value in [10, 25, 50, 100, 200, 300]" :value="value">
                  {{ value }}
                </SelectItem>
              </SelectGroup>
            </SelectContent>
          </Select>
          <PaginationContent v-slot="{ items }">
            <PaginationPrevious title="السابق"
              @click="goToPaginationPage(pageProps.paginate_meta.prev_page, pageProps.paginate_meta.per_page)" />

            <template v-for="(item, index) in items" :key="index">
              <PaginationItem v-if="item.type === 'page'" :value="item.value"
                :is-active="item.value === pageProps.paginate_meta.current_page"
                @click="goToPaginationPage(item.value, pageProps.paginate_meta.per_page)">
                {{ item.value }}
              </PaginationItem>
              <PaginationEllipsis v-else :index="index" />
            </template>

            <PaginationNext title="التالي"
              @click="goToPaginationPage(pageProps.paginate_meta.next_page, pageProps.paginate_meta.per_page)" />

          </PaginationContent>
        </Pagination>
      </div>

      <!-- Confirm Delete Modal -->
      <ConfirmDeleteModal :open="showDeleteDialog" @update:open="showDeleteDialog = $event"
        @confirm="handleDeleteConfirm" @cancel="closeDeleteDialog" title="هل أنت متأكد من حذف هذا {{entity_ar}}؟"
        description="سيتم حذف {{entity_ar}} وجميع الإعدادات المرتبطة به بشكل نهائي." confirm-button-text="حذف {{entity_ar}}"
        :item-name="{{entities}}.find((o: {{ENTITY}}) => o.id === {{entity}}ToDelete)?.name" />
    </div>
  </AppLayout>
</template>

