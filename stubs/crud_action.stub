package actions

import (
	"github.com/gin-gonic/gin"
	requests "{{REQUESTS_PATH}}"
	models "{{MODELS_PATH}}"
	x "{{X_APP_PATH}}"
)

type {{ENTITY}}Action struct {
	{{entity}}Repo *{{ENTITY}}Repository
}

func New{{ENTITY}}Action({{entity}}Repo *{{ENTITY}}Repository) *{{ENTITY}}Action {
	return &{{ENTITY}}Action{
		{{entity}}Repo: {{entity}}Repo,
	}
}

func (a *{{ENTITY}}Action) Create(c *gin.Context, req *requests.Create{{ENTITY}}Request) error {
	user, xerror := x.AuthUser(c)
	if xerror != nil {
		return xerror
	}

	{{entity}} := models.{{ENTITY}}{
		Name:     req.Name,
		TenantId: user.TenantId,
	}

	return a.{{entity}}Repo.Create(c, &{{entity}})
}

func (a *{{ENTITY}}Action) Delete(c *gin.Context, {{entity}}Id int64) error {
	user, xerror := x.AuthUser(c)
	if xerror != nil {
		return xerror
	}

	return a.{{entity}}Repo.Delete(c, &user.TenantId, {{entity}}Id)
}

func (a *{{ENTITY}}Action) Update(c *gin.Context, {{entity}}Id int64, req *requests.Update{{ENTITY}}Request) error {
	user, xerror := x.AuthUser(c)
	if xerror != nil {
		return xerror
	}

	{{entity}}, err := a.{{entity}}Repo.FindById(c, &user.TenantId, {{entity}}Id, nil)
	if err != nil {
		return err
	}

	req.ApplyToModel({{entity}})

	return a.{{entity}}Repo.Update(c, &user.TenantId, {{entity}})
}

